<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>ReleasedConsumer</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Bathos.Platform" Version="$(BathosVersion)" />
    <PackageReference Include="Bathos.Platform.Windows" Version="$(BathosVersion)" />
    <PackageReference Include="Bathos.Platform.MacOS" Version="$(BathosVersion)" />
    <PackageReference Include="Bathos.Platform.Linux" Version="$(BathosVersion)" />
  </ItemGroup>
</Project>
