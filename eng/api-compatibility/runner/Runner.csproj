<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- An assembly reference deliberately prevents rebuilding the released consumer with the candidate API. -->
    <Reference Include="ReleasedConsumer" HintPath="../baseline/bin/Release/net10.0/ReleasedConsumer.dll" />
    <PackageReference Include="Bathos.Platform" Version="$(BathosVersion)" />
    <PackageReference Include="Bathos.Platform.Windows" Version="$(BathosVersion)" />
    <PackageReference Include="Bathos.Platform.MacOS" Version="$(BathosVersion)" />
    <PackageReference Include="Bathos.Platform.Linux" Version="$(BathosVersion)" />
  </ItemGroup>
</Project>
